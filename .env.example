# =============================================================================
# LifelineSMS Gateway - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git. NEVER paste real secrets into client-side code.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public origin used for CSRF origin checks and CSP. No trailing slash.
APP_ORIGIN=http://localhost:3000

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes, hex encoded. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex_characters_minimum_00000000000000000000

# --- Google Identity Services (OAuth 2.0) -----------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Application type: "Web application". Authorised JS origin: your APP_ORIGIN.
# The CLIENT_ID is public and is safe to expose to the browser.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Optional: only needed if you exchange authorization codes server-side.
GOOGLE_CLIENT_SECRET=

# --- SMS Gateway Provider ---------------------------------------------------
# Provider adapter: mock | semaphore | twilio
SMS_PROVIDER=mock
# Semaphore (PH) ------------------------------------------------------------
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=LIFELINE
# Twilio -------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Abuse / Quota Controls -------------------------------------------------
# Free messages per verified user per rolling 24h window.
FREE_MESSAGES_PER_DAY=3
# Global cap per IP per hour (anti-toll-fraud).
MAX_SENDS_PER_IP_PER_HOUR=20
# Minimum account age (seconds) before a new sign-in may send. Slows throwaway
# account abuse.
MIN_ACCOUNT_AGE_SECONDS=60

# --- Moderation -------------------------------------------------------------
# Block messages at or above this severity score (0-100).
MODERATION_BLOCK_THRESHOLD=60
# Report-only mode: log violations but do not block (useful for tuning).
MODERATION_DRY_RUN=false
# Optional LLM second-opinion guard. Leave blank to disable.
AI_GUARD_ENDPOINT=
AI_GUARD_API_KEY=
AI_GUARD_MODEL=llama-3.1-8b-instant

# --- Audit Trail ------------------------------------------------------------
# Salt used to pseudonymise user identifiers inside audit records.
AUDIT_HASH_SALT=replace_me_with_a_long_random_salt_value_0000000000
AUDIT_LOG_PATH=./logs/audit.log
